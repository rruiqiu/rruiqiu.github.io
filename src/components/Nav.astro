---
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../data/site';

const path = Astro.url.pathname;
const isHome = path === '/';
const items = [
  { href: '/projects/', label: 'Projects' },
  { href: '/notes/', label: 'Notes' },
];
const isActive = (href: string) => path.startsWith(href);
---

<header class="flex items-center justify-between">
  <a
    href="/"
    class:list={[
      'link',
      isHome ? 'font-mono text-sm text-muted hover:text-fg' : 'font-medium tracking-tight text-fg',
    ]}
    aria-label="Home"
  >
    {isHome ? 'RQ' : site.name}
  </a>
  <nav class="flex items-center gap-5 text-sm" aria-label="Primary">
    {
      items.map((i) => (
        <a
          href={i.href}
          class:list={['link', isActive(i.href) ? 'text-fg' : 'text-muted hover:text-fg']}
          aria-current={isActive(i.href) ? 'page' : undefined}
        >
          {i.label}
        </a>
      ))
    }
    <a href={site.resume} target="_blank" rel="noopener" class="link text-muted hover:text-fg">
      Résumé<span aria-hidden="true" class="ml-0.5 text-[0.8em]">↗</span>
    </a>
    <ThemeToggle />
  </nav>
</header>
