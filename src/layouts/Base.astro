---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** narrow = home/projects, wide = notes index, full = category pages with a sidebar. */
  width?: 'narrow' | 'wide' | 'full';
}

const { title, description = site.description, width = 'narrow' } = Astro.props;
const maxWidth = { narrow: 'max-w-2xl', wide: 'max-w-3xl', full: 'max-w-5xl' }[width];
const fullTitle = title ? `${title} · ${site.name}` : site.name;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.fullName} />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fcfcfc" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0a0a0a" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={Astro.url.href} />
    {/* Privacy-friendly analytics (no cookies). Ignores localhost by default. */}
    <script is:inline data-goatcounter="https://rruiqiu.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
    {
      /* Google Analytics via Tag Manager (container GTM-PT273GW6 holds GA4 tag G-FLESNR8K3S).
         Production builds only, so the dev server never sends hits. */
      import.meta.env.PROD && (
        <>
          <script is:inline async src="https://www.googletagmanager.com/gtm.js?id=GTM-PT273GW6"></script>
          <script is:inline>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());
          </script>
        </>
      )
    }
    {/* Apply the saved theme before first paint to avoid a flash. */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          var dark = t ? t === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.classList.toggle('dark', dark);
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="bg-bg text-fg">
    <div class:list={['mx-auto px-6 pb-16 pt-4 sm:pt-8', maxWidth]}>
      {/* Sticky header: stays visible while scrolling, content blurs underneath. */}
      <div class="sticky top-0 z-20 -mx-6 bg-bg/85 px-6 pb-3 pt-6 backdrop-blur-md sm:pt-6">
        <Nav />
      </div>
      <main>
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
