---
import Base from './Base.astro';
import type { NoteMeta } from '../lib/notes';

interface Props {
  meta: NoteMeta;
}

const { meta } = Astro.props;
---

<Base title={meta.title} description={`${meta.title} — study notes by Richard Qiu.`} wide>
  <nav class="mt-12 font-mono text-xs text-muted sm:mt-16" aria-label="Breadcrumb">
    <a class="link hover:text-fg" href="/notes/">Notes</a>
    <span class="mx-1.5" aria-hidden="true">/</span>
    <span>{meta.category}</span>
    {
      meta.group && (
        <>
          <span class="mx-1.5" aria-hidden="true">/</span>
          <span>{meta.group}</span>
        </>
      )
    }
  </nav>
  <h1 class="mt-3 text-2xl font-semibold tracking-tight">{meta.title}</h1>
  <article class="prose mt-8 max-w-none">
    <slot />
  </article>
  <p class="mt-14">
    <a class="link font-mono text-xs text-muted hover:text-fg" href="/notes/">← All notes</a>
  </p>
</Base>
