---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" description="That page does not exist.">
  <section class="mt-14 sm:mt-20">
    <p class="font-mono text-xs uppercase tracking-[0.18em] text-muted">404</p>
    <h1 class="mt-3 text-2xl font-semibold tracking-tight">Nothing here.</h1>
    <p class="mt-3 text-muted">The page you were looking for has moved or never existed.</p>
    <p class="mt-6 flex flex-wrap gap-x-5 text-sm">
      <a class="link" href="/">Home</a>
      <a class="link" href="/projects/">Projects</a>
      <a class="link" href="/notes/">Notes</a>
    </p>
  </section>
</Base>
