---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Entry from '../../components/Entry.astro';
import { categoryPages } from '../../lib/notes';

const notes = await getCollection('notes');
const pages = categoryPages(notes);
---

<Base title="Notes" description="Study notes by Richard Qiu on data structures and algorithms, systems, design patterns and full-stack engineering.">
  <section class="mt-12 sm:mt-16">
    <h1 class="text-2xl font-semibold tracking-tight">Notes</h1>
    <p class="mt-2 text-muted">Study notes I keep while learning. Rough by design. One page per topic, with a table of contents.</p>
  </section>

  <div class="mt-10 divide-y divide-line border-y border-line">
    {
      pages.map((p) => (
        <Entry when={`${p.entries.length} notes`} class="py-5">
          <h2 class="font-medium leading-snug">
            <a class="link" href={p.href}>
              {p.label}
            </a>
          </h2>
          <p class="mt-1 text-sm leading-6 text-muted">{p.entries.map((e) => e.meta.title).join(' · ')}</p>
        </Entry>
      ))
    }
  </div>
</Base>
