---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import profile from '../assets/profile.jpg';
import Section from '../components/Section.astro';
import Entry from '../components/Entry.astro';
import Monogram from '../components/Monogram.astro';
import Icon from '../components/Icon.astro';
import Emphasis from '../components/Emphasis.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { site } from '../data/site';
import { experience } from '../data/experience';
import { featuredProjects } from '../data/projects';
import { skills } from '../data/skills';
import { education, certifications } from '../data/education';
---

<Base>
  <section class="reveal mt-14 sm:mt-20">
    <div class="flex items-center justify-between gap-6">
      <div>
        <h1 class="text-3xl font-semibold tracking-tight">{site.name}</h1>
        <p class="mt-1.5 text-muted">{site.focus.join(' · ')}</p>
        <p class="mt-1.5 flex items-center gap-1.5 text-sm text-muted">
          <Icon name="pin" class="size-3.5 shrink-0" />
          <span>{site.location}</span>
        </p>
      </div>
      <Image
        src={profile}
        alt={site.fullName}
        width={384}
        widths={[192, 288, 384, 560]}
        sizes="(min-width: 640px) 96px, 80px"
        format="webp"
        quality={92}
        class="size-20 shrink-0 rounded-2xl object-cover ring-1 ring-line sm:size-24"
      />
    </div>
    <div class="mt-6 space-y-4 text-[15.5px] leading-7 text-fg/90">
      {site.bio.map((p) => <p>{p}</p>)}
    </div>
    <SocialLinks class="mt-6" />
    <p class="mt-7 flex items-center gap-2.5 font-mono text-xs text-muted">
      <span class="dot-live size-1.5 shrink-0 rounded-full bg-green-500" aria-hidden="true"></span>
      <span>{site.currently}</span>
    </p>
  </section>

  <Section title="Experience" id="experience" delay={90}>
    <div class="space-y-10">
      {
        experience.map((e) => (
          <Entry when={`${e.start} — ${e.end}`}>
            <div class="flex items-start gap-3">
              <Monogram name={e.company} logo={e.logo} logoFull={e.logoFull} />
              <div class="min-w-0">
                <h3 class="font-medium leading-tight">
                  {e.url ? (
                    <a class="link" href={e.url} target="_blank" rel="noopener">
                      {e.company}
                    </a>
                  ) : (
                    e.company
                  )}
                </h3>
                <p class="mt-1 text-sm text-muted">
                  {e.role}
                  <span class="mx-1" aria-hidden="true">·</span>
                  {e.location}
                </p>
              </div>
            </div>
            <div data-expandable>
              <ul class="mt-4 list-disc space-y-1.5 pl-4 text-sm leading-6 text-fg/80 marker:text-line">
                {e.highlights.slice(0, e.visible ?? 2).map((h) => (
                  <li>
                    <Emphasis text={h} />
                  </li>
                ))}
              </ul>
              {e.highlights.length > (e.visible ?? 2) && (
                <>
                  <ul
                    class="mt-1.5 list-disc space-y-1.5 pl-4 text-sm leading-6 text-fg/80 marker:text-line"
                    data-more
                    hidden
                  >
                    {e.highlights.slice(e.visible ?? 2).map((h) => (
                      <li>
                    <Emphasis text={h} />
                  </li>
                    ))}
                  </ul>
                  <button
                    type="button"
                    data-toggle
                    aria-expanded="false"
                    class="group ml-4 mt-2.5 inline-flex items-center gap-1 font-mono text-[11px] text-muted transition-colors hover:text-fg"
                  >
                    <span data-label-more>Show {e.highlights.length - (e.visible ?? 2)} more</span>
                    <span data-label-less hidden>Show less</span>
                    <svg
                      class="size-3 transition-transform duration-300 group-aria-expanded:rotate-180"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="m6 9 6 6 6-6" />
                    </svg>
                  </button>
                </>
              )}
            </div>
            <p class="mt-3 font-mono text-[11px] text-muted">{e.stack.join(' · ')}</p>
          </Entry>
        ))
      }
    </div>
  </Section>

  <Section title="Selected Projects" id="projects" delay={180}>
    <a slot="aside" href="/projects/" class="link text-sm text-muted hover:text-fg">All projects →</a>
    <div class="grid gap-4 sm:grid-cols-2">
      {featuredProjects.map((p) => <ProjectCard project={p} />)}
    </div>
  </Section>

  <Section title="Skills" id="skills" delay={270}>
    <div class="space-y-4">
      {
        skills.map((s) => (
          <Entry when={s.label} wide>
            <p class="flex flex-wrap gap-x-3.5 gap-y-0.5 text-sm leading-6">
              {s.items.map((item, i) => (
                <span class:list={['whitespace-nowrap', i < s.primary ? 'text-fg' : 'text-muted']}>{item}</span>
              ))}
            </p>
          </Entry>
        ))
      }
    </div>
  </Section>

  <Section title="Education" id="education" delay={360}>
    <div class="space-y-6">
      {
        education.map((e) => (
          <Entry when={`${e.start} — ${e.end}`}>
            <div class="flex items-start gap-3">
              <Monogram name={e.school} logo={e.logo} logoFull={e.logoFull} />
              <div class="min-w-0">
                <h3 class="font-medium leading-tight">
                  {e.url ? (
                    <a class="link" href={e.url} target="_blank" rel="noopener">
                      {e.school}
                    </a>
                  ) : (
                    e.school
                  )}
                </h3>
                <p class="mt-1 text-sm text-muted">
                  {e.degree}
                  {e.detail && (
                    <>
                      <span class="mx-1" aria-hidden="true">·</span>
                      {e.detail}
                    </>
                  )}
                </p>
              </div>
            </div>
          </Entry>
        ))
      }
      {
        certifications.map((c) => (
          <Entry when={c.year}>
            <p class="text-sm leading-6 text-fg/85">{c.name}</p>
          </Entry>
        ))
      }
    </div>
  </Section>
</Base>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-toggle]')) {
    const wrap = btn.closest<HTMLElement>('[data-expandable]');
    const more = wrap?.querySelector<HTMLElement>('[data-more]');
    const labelMore = btn.querySelector<HTMLElement>('[data-label-more]');
    const labelLess = btn.querySelector<HTMLElement>('[data-label-less]');
    if (!more || !labelMore || !labelLess) continue;
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      more.hidden = open;
      labelMore.hidden = !open;
      labelLess.hidden = open;
    });
  }
</script>
